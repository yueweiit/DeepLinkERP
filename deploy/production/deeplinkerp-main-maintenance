#!/bin/sh
# Control only the marker consumed by the existing host nginx gate.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset ENV BASH_ENV CDPATH

if [ "$(/usr/bin/id -u)" -ne 0 ]; then
    printf '%s\n' 'Maintenance control requires root.' >&2
    exit 1
fi
if [ "$#" -ne 1 ]; then
    printf '%s\n' 'Usage: deeplinkerp-main-maintenance on|off|status' >&2
    exit 2
fi
case "$1" in
    on|off|status) action=$1 ;;
    *) printf '%s\n' 'Expected on, off, or status.' >&2; exit 2 ;;
esac

marker=/run/deeplinkerp-main-maintenance.on
if [ -L "$marker" ] || { [ -e "$marker" ] && [ ! -f "$marker" ]; }; then
    printf '%s\n' 'Refusing abnormal maintenance marker.' >&2
    exit 1
fi
case "$action" in
    on)
        if [ ! -f "$marker" ]; then
            (umask 022; set -C; : > "$marker")
        fi
        ;;
    off) /bin/rm -f -- "$marker" ;;
esac
state=off
if [ -f "$marker" ]; then state=on; fi
actor=${SUDO_USER:-root}
case "$actor" in *[!a-zA-Z0-9_-]*) actor=unknown ;; esac
/usr/bin/logger -t deeplinkerp-main-maintenance -- "action=$action actor=$actor state=$state"
printf '%s\n' "$state"
