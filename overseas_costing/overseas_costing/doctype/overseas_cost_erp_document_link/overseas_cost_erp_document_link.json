{
  "doctype": "DocType",
  "name": "Overseas Cost ERP Document Link",
  "module": "Overseas Costing",
  "autoname": "hash",
  "title_field": "business_key",
  "track_changes": 1,
  "field_order": ["batch", "stable_line_key", "site_code", "business_key", "remote_doctype", "remote_document", "remote_row", "remote_docstatus", "status", "last_cost_result_hash", "last_payload_hash", "verified_at", "remark"],
  "fields": [
    {"fieldname": "batch", "fieldtype": "Link", "label": "所属批次", "options": "Overseas Cost Batch", "reqd": 1, "in_list_view": 1},
    {"fieldname": "stable_line_key", "fieldtype": "Data", "label": "稳定物料行", "reqd": 1, "in_list_view": 1},
    {"fieldname": "site_code", "fieldtype": "Data", "label": "ERP 站点", "reqd": 1, "in_list_view": 1},
    {"fieldname": "business_key", "fieldtype": "Data", "label": "远端业务键", "reqd": 1},
    {"fieldname": "remote_doctype", "fieldtype": "Data", "label": "远端单据类型", "reqd": 1},
    {"fieldname": "remote_document", "fieldtype": "Data", "label": "远端单据", "reqd": 1, "in_list_view": 1},
    {"fieldname": "remote_row", "fieldtype": "Data", "label": "远端单据行", "reqd": 1},
    {"fieldname": "remote_docstatus", "fieldtype": "Int", "label": "远端单据状态", "read_only": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "关联状态", "options": "UNVERIFIED\nVERIFIED\nSUCCESS\nFAILED\nMANUAL_REQUIRED", "default": "UNVERIFIED", "reqd": 1},
    {"fieldname": "last_cost_result_hash", "fieldtype": "Data", "label": "已同步成本哈希", "read_only": 1},
    {"fieldname": "last_payload_hash", "fieldtype": "Data", "label": "已同步报文哈希", "read_only": 1},
    {"fieldname": "verified_at", "fieldtype": "Datetime", "label": "回读核验时间", "read_only": 1},
    {"fieldname": "remark", "fieldtype": "Small Text", "label": "备注"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "share": 1, "print": 1, "export": 1},
    {"role": "海外成本核算用户", "read": 1, "print": 1, "export": 1, "report": 1}
  ]
}
