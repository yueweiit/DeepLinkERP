{
  "doctype": "DocType",
  "name": "Overseas Cost Trial AI Run",
  "module": "Overseas Costing",
  "autoname": "hash",
  "title_field": "batch",
  "track_changes": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "field_order": [
    "batch",
    "version",
    "operator_name",
    "status",
    "input_fingerprint",
    "prompt_version",
    "model",
    "progress_revision",
    "progress_step",
    "progress_percent",
    "draft_json",
    "selection_json",
    "error_message",
    "started_at",
    "completed_at",
    "confirmed_at"
  ],
  "fields": [
    {"fieldname": "batch", "fieldtype": "Link", "label": "所属批次", "options": "Overseas Cost Batch", "reqd": 1, "in_list_view": 1},
    {"fieldname": "version", "fieldtype": "Link", "label": "所属版本", "options": "Overseas Cost Version", "reqd": 1},
    {"fieldname": "operator_name", "fieldtype": "Data", "label": "操作者"},
    {"fieldname": "status", "fieldtype": "Select", "label": "状态", "options": "QUEUED\nRUNNING\nREADY\nCONFIRMED\nDISCARDED\nSTALE\nFAILED", "default": "QUEUED", "reqd": 1, "in_list_view": 1},
    {"fieldname": "input_fingerprint", "fieldtype": "Data", "label": "输入指纹", "reqd": 1, "read_only": 1},
    {"fieldname": "prompt_version", "fieldtype": "Data", "label": "提示词版本", "reqd": 1, "read_only": 1},
    {"fieldname": "model", "fieldtype": "Data", "label": "AI 模型", "read_only": 1},
    {"fieldname": "progress_revision", "fieldtype": "Int", "label": "进度版本", "default": 0, "hidden": 1, "read_only": 1},
    {"fieldname": "progress_step", "fieldtype": "Data", "label": "当前步骤", "read_only": 1},
    {"fieldname": "progress_percent", "fieldtype": "Int", "label": "进度", "default": 0, "read_only": 1},
    {"fieldname": "draft_json", "fieldtype": "Long Text", "label": "AI 建议草稿 JSON", "read_only": 1},
    {"fieldname": "selection_json", "fieldtype": "Long Text", "label": "用户确认快照 JSON", "read_only": 1},
    {"fieldname": "error_message", "fieldtype": "Small Text", "label": "错误", "read_only": 1},
    {"fieldname": "started_at", "fieldtype": "Datetime", "label": "开始时间", "read_only": 1},
    {"fieldname": "completed_at", "fieldtype": "Datetime", "label": "完成时间", "read_only": 1},
    {"fieldname": "confirmed_at", "fieldtype": "Datetime", "label": "确认时间", "read_only": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "海外成本核算用户", "read": 1, "write": 1, "create": 1}
  ]
}
