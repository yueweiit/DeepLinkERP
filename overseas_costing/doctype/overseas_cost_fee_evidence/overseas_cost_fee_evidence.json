{
  "doctype": "DocType",
  "name": "Overseas Cost Fee Evidence",
  "module": "Overseas Costing",
  "autoname": "hash",
  "title_field": "evidence_role",
  "track_changes": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "field_order": [
    "batch",
    "version",
    "fee_rule",
    "attachment",
    "evidence_role",
    "validation_status",
    "source_revision",
    "validated_by",
    "validated_at",
    "remark",
    "evidence_type",
    "accounting_role",
    "currency",
    "original_amount",
    "direction",
    "related_evidence",
    "is_final",
    "attachment_fingerprint",
    "parse_snapshot_json",
    "confirmed_by",
    "confirmed_at",
    "review_run"
  ],
  "fields": [
    {
      "fieldname": "batch",
      "fieldtype": "Link",
      "label": "所属批次",
      "options": "Overseas Cost Batch",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "version",
      "fieldtype": "Link",
      "label": "所属版本",
      "options": "Overseas Cost Version",
      "reqd": 1
    },
    {
      "fieldname": "fee_rule",
      "fieldtype": "Link",
      "label": "费用规则",
      "options": "Overseas Cost Allocation Rule",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "attachment",
      "fieldtype": "Link",
      "label": "凭证附件",
      "options": "Overseas Cost Attachment"
    },
    {
      "fieldname": "evidence_role",
      "fieldtype": "Data",
      "label": "凭证角色",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "validation_status",
      "fieldtype": "Select",
      "label": "校验状态",
      "options": "PENDING\nVALID\nINVALID\nUNLINKED",
      "default": "PENDING",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "source_revision",
      "fieldtype": "Data",
      "label": "来源修订",
      "read_only": 1
    },
    {
      "fieldname": "validated_by",
      "fieldtype": "Link",
      "label": "校验人",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "validated_at",
      "fieldtype": "Datetime",
      "label": "校验时间",
      "read_only": 1
    },
    {
      "fieldname": "remark",
      "fieldtype": "Small Text",
      "label": "备注"
    },
    {
      "fieldname": "evidence_type",
      "fieldtype": "Select",
      "label": "凭证类型",
      "options": "QUOTE\nPREPAYMENT\nFINAL_INVOICE\nTAX_CERTIFICATE\nPAYMENT\nREFUND\nOTHER",
      "default": "OTHER"
    },
    {
      "fieldname": "accounting_role",
      "fieldtype": "Select",
      "label": "会计作用",
      "options": "ESTIMATE\nFINAL_BILL\nSETTLEMENT\nREFERENCE",
      "default": "REFERENCE"
    },
    {
      "fieldname": "currency",
      "fieldtype": "Select",
      "label": "币种",
      "options": "RMB\nMXN\nUSD",
      "default": "RMB"
    },
    {
      "fieldname": "original_amount",
      "fieldtype": "Currency",
      "label": "原币金额"
    },
    {
      "fieldname": "direction",
      "fieldtype": "Select",
      "label": "收付方向",
      "options": "DEBIT\nCREDIT",
      "default": "DEBIT"
    },
    {
      "fieldname": "related_evidence",
      "fieldtype": "Link",
      "label": "关联原付款凭证",
      "options": "Overseas Cost Fee Evidence"
    },
    {
      "fieldname": "is_final",
      "fieldtype": "Check",
      "label": "最终凭证",
      "default": 0
    },
    {
      "fieldname": "attachment_fingerprint",
      "fieldtype": "Data",
      "label": "附件指纹",
      "read_only": 1
    },
    {
      "fieldname": "parse_snapshot_json",
      "fieldtype": "Long Text",
      "label": "解析确认快照 JSON",
      "read_only": 1
    },
    {
      "fieldname": "confirmed_by",
      "fieldtype": "Link",
      "label": "确认人",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "confirmed_at",
      "fieldtype": "Datetime",
      "label": "确认时间",
      "read_only": 1
    },
    {
      "fieldname": "review_run",
      "fieldtype": "Link",
      "label": "AI 审核任务",
      "options": "Overseas Cost Fee Evidence AI Run",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "share": 1,
      "print": 1,
      "email": 1,
      "export": 1
    },
    {
      "role": "海外成本核算用户",
      "read": 1,
      "write": 1,
      "create": 1,
      "print": 1,
      "export": 1,
      "report": 1
    }
  ]
}
