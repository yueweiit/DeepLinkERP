# Safe local defaults. Copy to .env.local and use it with:
# docker compose --env-file services/phone-watch/.env.local up --build

PHONE_WATCH_DB_BACKEND=postgres
PHONE_WATCH_PG_DRIVER=pg8000
PHONE_WATCH_PG_HOST=phone-watch-db
PHONE_WATCH_PG_DATABASE=phone_scraper
PHONE_WATCH_PG_USER=postgres
PHONE_WATCH_PG_PASSWORD=replace_with_local_password
PHONE_WATCH_PG_PORT=5432
PHONE_WATCH_PG_OPTIONS=-c client_encoding=utf8
PHONE_WATCH_PG_CONNECT_TIMEOUT=10

# Defense in depth: reject non-loopback/non-compose database hosts locally.
PHONE_WATCH_LOCAL_ONLY=true

# Internal API only. Use a different random value outside local development.
PHONE_WATCH_INTERNAL_TOKEN=replace_with_random_service_token
PHONE_WATCH_LEGACY_API_ENABLED=false

# DingTalk writes are never enabled by the local migration environment.
PHONE_WATCH_DINGTALK_WRITE_ENABLED=false

# Absolute path to the verified custom-format pg_dump. Never commit the dump.
PHONE_WATCH_DUMP_PATH=/absolute/path/to/phone-scraper.dump

# PLM feature flag and upstream client settings.
APP_PHONE_WATCH_ENABLED=true
APP_PHONE_WATCH_BASE_URL=http://phone-watch:8000
APP_PHONE_WATCH_TOKEN=replace_with_the_same_service_token
APP_PHONE_WATCH_CONNECT_TIMEOUT_MS=2000
APP_PHONE_WATCH_READ_TIMEOUT_MS=10000
