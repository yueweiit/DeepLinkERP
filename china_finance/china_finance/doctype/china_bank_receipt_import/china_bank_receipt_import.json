   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "bank_account",
   "label": "银行账户",
   "fieldtype": "Link",
   "options": "Bank Account",
   "reqd": 1
  },
  {
   "fieldname": "mode",
   "label": "用途",
