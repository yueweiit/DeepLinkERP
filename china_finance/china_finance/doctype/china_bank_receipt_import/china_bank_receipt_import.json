{
 "doctype": "DocType",
 "name": "China Bank Receipt Import",
 "module": "China Finance",
 "engine": "InnoDB",
 "field_order": [
  "company",
  "bank_account",
  "mode",
  "source_file",
  "status",
  "source_hash",
  "parser_version",
  "currency",
  "deposit_total",
  "withdrawal_total",
