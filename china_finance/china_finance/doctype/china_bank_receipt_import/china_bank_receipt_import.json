   "options": "currency",
   "read_only": 1
  },
  {
   "fieldname": "withdrawal_total",
   "label": "支出合计",
   "fieldtype": "Currency",
   "options": "currency",
   "read_only": 1
  },
  {
   "fieldname": "parse_errors",
