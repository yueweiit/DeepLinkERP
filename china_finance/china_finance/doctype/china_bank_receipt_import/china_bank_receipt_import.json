   "hidden": 1
  },
  {
   "fieldname": "parser_version",
   "label": "解析版本",
   "fieldtype": "Data",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "currency",
   "label": "币种",
   "fieldtype": "Link",
   "options": "Currency",
   "default": "CNY",
   "read_only": 1
  },
  {
   "fieldname": "deposit_total",
